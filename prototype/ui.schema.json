  "entity_states": {
    "issue": [
      "待梳理",
      "待处理",
      "处理中",
      "待验证",
      "已解决",
      "已暂缓",
      "已关闭"
    ],
    "task": [
      "待办",
      "进行中",
      "已完成",
      "已取消"
    ]
  },
  "notes": "组件是复用组件定义；实例通过data-action与data-id识别。表单输入通过name与所属form识别，提交时统一读取，事件委托绑定在document。",
  "issue_transitions": {
    "triage": {
      "from": [
        "待梳理"
      ],
      "to": "待处理",
      "required": [
        "nextStep",
        "successCriteria"
      ]
    },
    "start": {
      "from": [
        "待处理"
      ],
      "to": "处理中",
      "guard": "nextStep与successCriteria已填写"
    },
    "verify": {
      "from": [
        "待梳理",
        "待处理",
        "处理中"
      ],
      "to": "待验证",
      "required": [
        "successCriteria",
        "treatment",
        "verificationMethod"
      ],
      "guard": "无未完成必要行动；前两种源状态仅在零关联行动时允许直接观察验证"
    },
    "resolve": {
      "from": [
        "待验证"
      ],
      "to": "已解决",
      "required": [
        "resolution"
      ],
      "guard": "无未完成必要行动"
    },
    "reject": {
      "from": [
        "待验证"
      ],
      "to": "处理中",
      "required": [
        "reason"
      ]
    },
    "pause": {
      "from": [
        "待梳理",
        "待处理",
        "处理中",
        "待验证"
      ],
      "to": "已暂缓",
      "required": [
        "reason",
        "reviewDate"
      ],
      "guard": "回看日期不得早于今天；保存pausedFrom"
    },
    "resume": {
      "from": [
        "已暂缓"
      ],
      "to": "pausedFrom",
      "guard": "恢复待验证时若有未完成必要行动则退回处理中"
    },
    "close-issue": {
      "from": [
        "待梳理",
        "待处理",
        "处理中",
        "待验证",
        "已暂缓"
      ],
      "to": "已关闭",
      "required": [
        "reason",
        "closeType"
      ],
      "guard": "重复需duplicateOf，存在未完成行动需taskPolicy=detach或cancel"
    },
    "reopen": {
      "from": [
        "已解决",
        "已关闭"
      ],
      "to": "已解决重开到处理中；已关闭重开到待梳理",
      "required": [
        "reason"
      ]
    },
    "retriage": {
      "from": [
        "待处理"
      ],
      "to": "待梳理",
      "required": [
        "reason"
      ]
    }
  },
  "followup_fields": {
    "id": "string",
    "content": "trimmed text, 1..5000",
    "at": "ISO timestamp",
    "actor": "当前使用者昵称"
  },
  "distribution": {
    "scope": "all issues including resolved, deferred and closed",
    "position": "analysis page, issues tab; today has entry link only",
    "metrics": [
      "count",
      "rounded percentage"
    ],
    "empty": "zero safe; no category data message",
    "category_source": "distinct trimmed issue.tag, blank becomes 未分类"
  },
  "action_distribution": {
    "scope_status": "all tasks",
