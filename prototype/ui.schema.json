    "scenarios": [
      {
        "id": "generic-profile",
        "requirement_ids": [
          "REQ-001",
          "REQ-017"
        ],
        "steps": [
          {
            "action": "click",
            "selector": ".identity-button:visible"
          },
          {
            "action": "click",
            "selector": "dialog[open] [data-action=\"add-profile\"]"
          },
          {
            "action": "fill",
            "selector": "dialog[open] [name=\"profileName\"]",
            "value": "自定义成员"
          },
          {
            "action": "click",
            "selector": "dialog[open] button[type=\"submit\"]"
          },
          {
            "action": "expect_text",
            "selector": ".identity-button:visible",
            "value": "自定义成员"
          },
          {
            "action": "click",
            "selector": "#app [data-action=\"new\"]"
          },
          {
            "action": "fill",
            "selector": "dialog[open] [name=\"title\"]",
            "value": "成员记录"
          },
          {
            "action": "click",
            "selector": "dialog[open] button[type=\"submit\"]"
          },
          {
            "action": "click",
            "selector": "nav:visible [data-action=\"nav\"][data-id=\"issues\"]"
          },
          {
            "action": "expect_text",
            "selector": ".issue-card:has-text(\"成员记录\") .creator-line",
            "value": "自定义成员"
          },
          {
            "action": "click",
            "selector": ".issue-card:has-text(\"成员记录\") .issue-title"
          },
          {
            "action": "expect_text",
            "selector": "dialog[open] .creation-detail",
            "value": "手动"
          }
        ]
      },
      {
        "id": "create-ai-action",
        "requirement_ids": [
          "REQ-003",
          "REQ-017"
        ],
        "steps": [
          {
            "action": "click",
            "selector": "nav:visible [data-action=\"nav\"][data-id=\"tasks\"]"
          },
          {
            "action": "click",
            "selector": "#app .pagehead>.primary"
          },
          {
            "action": "select",
            "selector": "dialog[open] #kind",
            "value": "task"
          },
          {
            "action": "click",
            "selector": "dialog[open] .creation-config summary"
          },
          {
            "action": "select",
            "selector": "dialog[open] [name=\"creationVia\"]",
            "value": "deepseek_harness"
          },
          {
            "action": "select",
            "selector": "dialog[open] [name=\"creationPerson\"]",
            "value": "ai"
          },
          {
            "action": "fill",
            "selector": "dialog[open] [name=\"modelName\"]",
            "value": "测试模型-v1"
          },
          {
            "action": "fill",
            "selector": "dialog[open] [name=\"modelProvider\"]",
            "value": "测试提供方"
          },
          {
            "action": "fill",
            "selector": "dialog[open] [name=\"title\"]",
            "value": "AI自主创建的行动"
          },
          {
            "action": "click",
            "selector": "dialog[open] button[type=\"submit\"]"
          },
          {
            "action": "select",
            "selector": "[aria-label=\"按创建来源筛选\"]",
            "value": "deepseek_harness"
          },
          {
            "action": "expect_text",
            "selector": "#app",
            "value": "AI自主创建的行动"
          },
          {
            "action": "expect_visible",
            "selector": "#app :is(.mobile-task-card,.action-row):has-text(\"AI自主创建的行动\") .creator-line"
          },
          {
            "action": "expect_text",
            "selector": "#app :is(.mobile-task-card,.action-row):has-text(\"AI自主创建的行动\") .creator-line",
            "value": "测试模型-v1"
          }
        ]
