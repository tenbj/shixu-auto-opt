  "input": {
    "intent": "设计个人问题痛点与待办工作台，让记录的问题转为行动并得到验证闭环",
    "target_users": [
      "个人或家庭成员",
      "AI录入工具"
    ],
    "product_context": "个人工作台；移动端行动优先，保留桌面布局和七状态业务规则。",
    "target_platform": "web",
    "constraints": [
      "单文件离线可打开",
      "本版不实现多人同步、账号与云端服务"
    ],
    "assumptions": [
      "示例均为虚构数据",
      "浏览器本地保存并提供JSON导出",
      "问题可关联多个待办，待办可以独立创建",
      "手机独立呈现，桌面沿用既有布局",
      "原型使用独立localStorage键，不访问线上API",
      "身份选择仅用于原型演示；正式服务须由认证和AI连接绑定身份",
      "通用可配置身份；默认Codex/GPT-6/OpenAI演示，只留一个未知问题；模型依据会话声明"
    ],
    "requirements": [
      {
        "id": "REQ-001",
        "statement": "快速记录问题或待办",
        "acceptance_criteria": [
          "仅标题必填",
          "空白标题不能保存"
        ]
      },
      {
        "id": "REQ-002",
        "statement": "浏览、搜索和筛选问题池",
        "acceptance_criteria": [
          "按标题描述搜索",
          "按优先级筛选",
          "无匹配显示空态"
        ]
      },
      {
        "id": "REQ-003",
        "statement": "问题拆解为关联待办",
        "acceptance_criteria": [
          "可从问题详情创建多个待办",
          "创建后可追溯来源"
        ]
      },
      {
        "id": "REQ-004",
        "statement": "关注今日行动并推进待办",
        "acceptance_criteria": [
          "显示今日和逾期未完成事项",
          "支持待办、进行中、已完成状态切换"
        ]
      },
      {
        "id": "REQ-005",
        "statement": "验证问题是否解决",
        "acceptance_criteria": [
          "尚有未完成必要行动不能进入验证/解决",
          "待验证填写非空验证结论才能解决",
          "解决的问题可以填写原因重新打开"
        ]
      },
      {
        "id": "REQ-006",
        "statement": "本地保存与导出",
        "acceptance_criteria": [
          "刷新保留数据",
          "本地保存失败有明确提示",
          "可导出包含问题和待办的JSON"
        ]
      },
      {
        "id": "REQ-007",
        "statement": "问题七状态与受约束流转",
        "acceptance_criteria": [
          "新建只填标题且默认待梳理",
          "完成梳理、开始、验证、解决有明确动作与校验",
          "非法状态跳转拒绝且不改数据"
        ]
      },
      {
        "id": "REQ-008",
        "statement": "暂缓恢复与关闭重开",
        "acceptance_criteria": [
          "暂缓要求原因及回看日期，并恢复原阶段",
          "关闭必须说明原因并处置未完成行动",
          "重复问题关联原问题"
        ]
      },
      {
        "id": "REQ-009",
        "statement": "按状态呈现与筛选",
        "acceptance_criteria": [
          "卡片有状态徽标",
          "七状态可筛选",
          "暂缓到期首页提示",
          "暂缓任务不挤入今日行动",
          "状态快捷筛选首项为全部并显示总数",
          "问题卡片标题旁有醒目状态徽标"
        ]
      },
      {
        "id": "REQ-010",
        "statement": "兼容原有本地记录",
        "acceptance_criteria": [
          "存储键和version保持1，schemaVersion升级2",
          "旧记录内容、状态和日志不改写",
          "导出包含完整新字段和状态轨迹"
        ]
      },
      {
        "id": "REQ-011",
        "statement": "必要行动与后续改进区分",
        "acceptance_criteria": [
          "必要行动完成或说明原因取消才可验证",
          "后续改进不阻止验证",
          "重新打开必要行动使已解决或待验证问题回到处理中"
        ]
      },
      {
        "id": "REQ-012",
        "statement": "快捷记录问题跟进并按时间查看",
        "acceptance_criteria": [
          "问题卡片和详情均有记跟进入口",
          "跟进只需正文，拒绝空白与超过5000字",
          "自动记录时间与记录人，最新在前，不改变问题状态",
          "列表显示最近跟进摘要，旧记录、刷新保存和JSON导出兼容",
          "行动状态与问题状态明确区分，卡片标题与状态相邻"
        ]
      },
      {
        "id": "REQ-013",
        "statement": "可编辑问题背景、按分类筛选与概览分布",
        "acceptance_criteria": [
          "背景显示标题，支持直接编辑或补充，保存返回详情",
          "分类下拉替换状态下拉，动态收集分类；状态保留快捷标签",
          "状态分类优先级关键词可组合筛选",
          "独立统计分析页的问题页签展示状态分类数量占比，今日仅留入口",
          "点击分布清除旧筛选后跳至匹配列表",
          "空数据与手机布局有效，旧记录兼容"
        ]
      },
      {
        "id": "REQ-014",
        "statement": "行动分析与看板跳转",
        "acceptance_criteria": [
          "统计分析页提供问题与行动两个页签",
          "行动四状态计数与总数相符",
          "时间分布只包含待办和进行中，已完成和取消不计逾期",
          "点击图表进入带条件的看板，可清除筛选",
          "空数据与手机布局正确"
        ]
      },
      {
        "id": "REQ-015",
        "statement": "快捷修改属性并查看整体状态流转和复盘用途",
        "acceptance_criteria": [
          "问题卡片与详情的优先级分类可点击修改",
          "原值回填并可输入新分类，空值归未分类，保存不改状态和背景",
          "全局状态流转入口和详情入口展示问题/行动完整主流程与异常返回图",
          "详细条件可展开查看，手机图表局部横向滚动",
          "复盘页说明来源用途和边界，仅展示已解决问题的验证结论"
        ]
      },
      {
        "id": "REQ-016",
        "statement": "移动端以行动为核心的响应式呈现",
        "acceptance_criteria": [
          "360/390/430px首页首项行动位于首屏",
          "五项底部导航可用且不遮挡最后内容",
          "行动标题、日期、状态和主要操作无需横向滚动",
          "按问题选择、状态筛选与日程列表可交互",
          "手机详情和表单全屏，嵌套编辑可返回并保存",
          "主要触控区域至少44px，输入字体16px",
          "桌面保留原有分栏表格与月历，业务流转约束不变"
        ]
      },
      {
        "id": "REQ-017",
        "statement": "问题与行动创建身份及AI来源",
        "acceptance_criteria": [
          "任意名称的人或AI身份，可新增/编辑/切换，默认自动填入",
          "工具与模型名称/ID、提供方独立记录",
          "列表及详情展示创建快照，双筛选",
          "编辑和身份设置不改历史信息；JSON导出包含配置",
          "仅一条未知演示，其余按Codex/GPT-6/OpenAI创建"
        ]
      },
      {
        "id": "REQ-090",
        "statement": "AI工具支持其他与自定义，账号独立保存和复用",
        "acceptance_criteria": [
          "保存复用、刷新恢复、来源筛选",
          "同名复用与失败保留草稿",
          "独立工具字典、历史来源保留和账号隔离"
        ]
      }
    ]
  },
  "product": "拾序 · 个人工作台",
  "version": "1.6.0",
  "runtime": "offline personal browser prototype",
  "limitations": [
    "本地数据，无账号或跨设备同步",
    "API与SQL仅为工程合同",
    "JSON可导出，未提供导入UI"
  ],
  "capabilities": [
    "responsive-web-v1"
  ],
  "prototype_release": "1.9.0"
}
