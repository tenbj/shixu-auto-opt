{
  "asoc_version": "1.0.0",
  "skill": "HH02_原型设计",
  "intent": "设计个人问题痛点与待办工作台，让记录的问题转为行动并得到验证闭环",
  "artifacts": [
    {
      "id": "prd",
      "path": "prd.md",
      "layer": "human"
    },
    {
      "id": "prototype",
      "path": "prototype.html",
      "layer": "human"
    },
    {
      "id": "ui",
      "path": "ui.schema.json",
      "layer": "machine"
    },
    {
      "id": "interaction",
      "path": "interaction.json",
      "layer": "machine"
    },
    {
      "id": "flow",
      "path": "user-flow.md",
      "layer": "human"
    },
    {
      "id": "api",
      "path": "api.yaml",
      "layer": "machine"
    },
    {
      "id": "database",
      "path": "database.sql",
      "layer": "machine"
    },
    {
      "id": "evaluation",
      "path": "evaluation/report.json",
      "layer": "evaluation"
    },
    {
      "id": "browser-tests",
      "path": "evaluation/browser-tests.json",
      "layer": "evaluation"
    },
    {
      "id": "workflow-test",
      "path": "evaluation/workflow-test.js",
      "layer": "evaluation"
    },
    {
      "id": "workflow-report",
      "path": "evaluation/workflow-report.json",
      "layer": "evaluation"
    }
  ],
  "input": {
    "intent": "设计个人问题痛点与待办工作台，让记录的问题转为行动并得到验证闭环",
    "target_users": [
      "个人工作者"
    ],
    "product_context": "个人工作台；保持现有视觉和快捷记录，新问题默认待梳理。",
    "target_platform": "web",
    "constraints": [
      "单文件离线可打开",
      "本版不实现多人同步、账号与云端服务"
    ],
    "assumptions": [
      "桌面优先并适配手机",
      "示例均为虚构数据",
      "浏览器本地保存并提供JSON导出",
      "问题可关联多个待办，待办可以独立创建"
    ],
    "requirements": [
      {
        "id": "REQ-001",
        "statement": "快速记录问题或待办",
        "acceptance_criteria": [
          "仅标题必填",
          "空白标题不能保存"
        ]
      },
      {
        "id": "REQ-002",
        "statement": "浏览、搜索和筛选问题池",
        "acceptance_criteria": [
          "按标题描述搜索",
          "按优先级筛选",
          "无匹配显示空态"
        ]
      },
      {
        "id": "REQ-003",
        "statement": "问题拆解为关联待办",
        "acceptance_criteria": [
          "可从问题详情创建多个待办",
          "创建后可追溯来源"
        ]
      },
      {
        "id": "REQ-004",
        "statement": "关注今日行动并推进待办",
        "acceptance_criteria": [
          "显示今日和逾期未完成事项",
          "支持待办、进行中、已完成状态切换"
        ]
      },
      {
        "id": "REQ-005",
        "statement": "验证问题是否解决",
        "acceptance_criteria": [
          "尚有未完成必要行动不能进入验证/解决",
          "待验证填写非空验证结论才能解决",
          "解决的问题可以填写原因重新打开"
        ]
      },
      {
        "id": "REQ-006",
        "statement": "本地保存与导出",
        "acceptance_criteria": [
          "刷新保留数据",
          "本地保存失败有明确提示",
          "可导出包含问题和待办的JSON"
        ]
      },
      {
        "id": "REQ-007",
        "statement": "问题七状态与受约束流转",
        "acceptance_criteria": [
          "新建只填标题且默认待梳理",
          "完成梳理、开始、验证、解决有明确动作与校验",
          "非法状态跳转拒绝且不改数据"
        ]
      },
      {
        "id": "REQ-008",
        "statement": "暂缓恢复与关闭重开",
        "acceptance_criteria": [
          "暂缓要求原因及回看日期，并恢复原阶段",
          "关闭必须说明原因并处置未完成行动",
          "重复问题关联原问题"
        ]
      },
      {
        "id": "REQ-009",
        "statement": "按状态呈现与筛选",
        "acceptance_criteria": [
          "卡片有状态徽标",
          "七状态可筛选",
          "暂缓到期首页提示",
          "暂缓任务不挤入今日行动"
        ]
      },
      {
        "id": "REQ-010",
        "statement": "兼容原有本地记录",
        "acceptance_criteria": [
          "存储键和version保持1，schemaVersion升级2",
          "旧记录内容、状态和日志不改写",
          "导出包含完整新字段和状态轨迹"
        ]
      },
      {
        "id": "REQ-011",
        "statement": "必要行动与后续改进区分",
        "acceptance_criteria": [
          "必要行动完成或说明原因取消才可验证",
          "后续改进不阻止验证",
          "重新打开必要行动使已解决或待验证问题回到处理中"
        ]
      }
    ]
  },
  "product": "拾序 · 个人工作台",
  "version": "1.1.0",
  "runtime": "offline personal browser prototype",
  "limitations": [
    "本地数据，无账号或跨设备同步",
    "API与SQL仅为工程合同",
    "JSON可导出，未提供导入UI"
  ]
}
