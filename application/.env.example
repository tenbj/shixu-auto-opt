# 推荐：.env只保存仓库外私有配置文件指针，不在仓库内写入密码。
# SHIXU_ENV_FILE=C:/Users/your-name/.config/shixu/system.env
# 私有文件填写下列变量；SHIXU_ENV_FILE文件会自动加载，现有进程环境优先。
SHIXU_BACKEND=mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=shixu_your_workspace
DB_CHARSET=utf8mb4
DB_SSL=true
# DB_SSL_CA=/absolute/path/to/ca.pem
SHIXU_API_URL=http://127.0.0.1:8765
# 内网访问时改为0.0.0.0，并把实际服务器内网IP加入允许列表（逗号分隔）。
SHIXU_HOST=127.0.0.1
SHIXU_ALLOWED_HOSTS=
