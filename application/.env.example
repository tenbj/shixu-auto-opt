# 推荐：.env只保存仓库外私有配置文件指针，不在仓库内写入密码。
# SHIXU_ENV_FILE=C:/Users/your-name/.config/shixu/system.env
# 私有文件填写下列变量；SHIXU_ENV_FILE文件会自动加载，现有进程环境优先。
SHIXU_BACKEND=mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=shixu_your_workspace
DB_CHARSET=utf8mb4
DB_SSL=true
# DB_SSL_CA=/absolute/path/to/ca.pem
SHIXU_API_URL=http://127.0.0.1:8765
# 内网访问时改为0.0.0.0，并把实际服务器内网IP加入允许列表（逗号分隔）。
SHIXU_HOST=127.0.0.1
SHIXU_ALLOWED_HOSTS=

# 3.0使用账号数据库中的OAuth/PAT摘要，旧文件密钥设置停用。

# 账号注册开关
SHIXU_ALLOW_REGISTRATION=true
# 公网HTTP网页登录和PAT/API/MCP兼容；默认false，明确启用后支持HTTP和HTTPS。
# HTTP明文传输；标准远程OAuth始终要求HTTPS。
SHIXU_ALLOW_HTTP_AUTH=false
# HTTPS代理部署时仅填写实际可信代理来源IP；TCP穿透模式留空，勿信任客户端伪造的协议头。
SHIXU_TRUSTED_PROXY_IPS=
# 同时保留公开HTTP TCP隧道时：可选专属HTTPS代理标记（私有配置，不提交密钥）。
# Caddy覆盖X-Shixu-HTTPS-Proof和X-Forwarded-Proto；仍保持TRUSTED_PROXY_IPS为空。
# SHIXU_HTTPS_PROXY_SECRET=<至少32字符随机值>
# 对外规范地址；配置HTTPS时，OAuth及MCP/PAT配置优先使用该HTTPS入口。
# SHIXU_PUBLIC_URL=https://your-domain
# 首次初始化/迁移的初始密码、客户端令牌仅通过私有进程环境提供
