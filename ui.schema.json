{
  "version": "1.2.0",
  "page": {
    "id": "personal-workspace",
    "states": [
      "loading",
      "ready",
      "editing",
      "detail",
      "validating",
      "success",
      "empty",
      "error"
    ],
    "views": [
      {
        "id": "today",
        "title": "今日概览"
      },
      {
        "id": "issues",
        "title": "问题池"
      },
      {
        "id": "tasks",
        "title": "行动看板"
      },
      {
        "id": "review",
        "title": "复盘记录"
      }
    ]
  },
  "components": [
    {
      "id": "field-control",
      "type": "form-input",
      "selector": "[data-event-id=\"EVT-FIELD\"]",
      "events": [
        "EVT-FIELD"
      ],
      "states": [
        "editing",
        "validating"
      ],
      "requirement_ids": [
        "REQ-001",
        "REQ-003",
        "REQ-005",
        "REQ-007",
        "REQ-008",
        "REQ-009",
        "REQ-010",
        "REQ-011",
        "REQ-012"
      ]
    },
    {
      "id": "action-control",
      "type": "reusable-button",
      "selector": "[data-event-id=\"EVT-ACTION\"]",
      "events": [
        "EVT-ACTION"
      ],
      "states": [
        "ready",
        "detail",
        "success"
      ],
      "requirement_ids": [
        "REQ-001",
        "REQ-003",
        "REQ-004",
        "REQ-005",
        "REQ-006",
        "REQ-007",
        "REQ-008",
        "REQ-009",
        "REQ-010",
        "REQ-011",
        "REQ-012"
      ],
      "variants": {
        "nav": "切换 today/issues/tasks/review 页面",
        "new": "新建问题",
        "new-task": "新建独立或关联行动",
        "new-linked": "从问题新增行动",
        "detail": "显示问题及行动与处理记录",
        "edit-task": "编辑行动",
        "edit-issue": "编辑问题",
        "close": "取消并关闭弹窗",
        "toggle": "完成/重开行动；必要时重开问题",
        "advance": "待办与进行中切换",
        "resolve": "已解决",
        "reopen": "已解决重开到处理中；已关闭重开到待梳理",
        "export": "下载当前JSON记录",
        "triage": "待处理",
        "start": "处理中",
        "verify": "待验证",
        "reject": "处理中",
        "pause": "已暂缓",
        "resume": "pausedFrom",
        "close-issue": "已关闭",
        "retriage": "待梳理",
        "cancel-task": "取消行动并填写理由",
        "status-filter": "七状态筛选",
        "followup": "打开问题跟进输入"
      }
    },
    {
      "id": "filter-control",
      "type": "search-and-select",
      "selector": "[data-event-id=\"EVT-FILTER\"]",
      "events": [
        "EVT-FILTER"
      ],
      "states": [
        "ready",
        "empty"
      ],
      "requirement_ids": [
        "REQ-002",
        "REQ-007",
        "REQ-008",
        "REQ-009",
        "REQ-010",
        "REQ-011"
      ]
    },
    {
      "id": "kind-control",
      "type": "select",
      "selector": "[data-event-id=\"EVT-KIND\"]",
      "events": [
        "EVT-KIND"
      ],
      "states": [
        "editing"
      ],
      "requirement_ids": [
        "REQ-001",
        "REQ-007",
        "REQ-008",
        "REQ-009",
        "REQ-010",
        "REQ-011"
      ]
    },
    {
      "id": "record-form",
      "type": "form",
      "selector": "form[data-event-id=\"EVT-SUBMIT\"]",
      "events": [
        "EVT-SUBMIT"
      ],
      "states": [
        "editing",
        "validating",
        "success",
        "error"
      ],
      "requirement_ids": [
        "REQ-001",
        "REQ-003",
        "REQ-005",
        "REQ-006",
        "REQ-007",
        "REQ-008",
        "REQ-009",
        "REQ-010",
        "REQ-011"
      ]
    }
  ],
  "entity_states": {
    "issue": [
      "待梳理",
      "待处理",
      "处理中",
      "待验证",
      "已解决",
      "已暂缓",
      "已关闭"
    ],
    "task": [
      "待办",
      "进行中",
      "已完成",
      "已取消"
    ]
  },
  "notes": "组件是复用组件定义；实例通过data-action与data-id识别。表单输入通过name与所属form识别，提交时统一读取，事件委托绑定在document。",
  "issue_transitions": {
    "triage": {
      "from": [
        "待梳理"
      ],
      "to": "待处理",
      "required": [
        "nextStep",
        "successCriteria"
      ]
    },
    "start": {
      "from": [
        "待处理"
      ],
      "to": "处理中",
      "guard": "nextStep与successCriteria已填写"
    },
    "verify": {
      "from": [
        "待梳理",
        "待处理",
        "处理中"
      ],
      "to": "待验证",
      "required": [
        "successCriteria",
        "treatment",
        "verificationMethod"
      ],
      "guard": "无未完成必要行动；前两种源状态仅在零关联行动时允许直接观察验证"
    },
    "resolve": {
      "from": [
        "待验证"
      ],
      "to": "已解决",
      "required": [
        "resolution"
      ],
      "guard": "无未完成必要行动"
    },
    "reject": {
      "from": [
        "待验证"
      ],
      "to": "处理中",
      "required": [
        "reason"
      ]
    },
    "pause": {
      "from": [
        "待梳理",
        "待处理",
        "处理中",
        "待验证"
      ],
      "to": "已暂缓",
      "required": [
        "reason",
        "reviewDate"
      ],
      "guard": "回看日期不得早于今天；保存pausedFrom"
    },
    "resume": {
      "from": [
        "已暂缓"
      ],
      "to": "pausedFrom",
      "guard": "恢复待验证时若有未完成必要行动则退回处理中"
    },
    "close-issue": {
      "from": [
        "待梳理",
        "待处理",
        "处理中",
        "待验证",
        "已暂缓"
      ],
      "to": "已关闭",
      "required": [
        "reason",
        "closeType"
      ],
      "guard": "重复需duplicateOf，存在未完成行动需taskPolicy=detach或cancel"
    },
    "reopen": {
      "from": [
        "已解决",
        "已关闭"
      ],
      "to": "已解决重开到处理中；已关闭重开到待梳理",
      "required": [
        "reason"
      ]
    },
    "retriage": {
      "from": [
        "待处理"
      ],
      "to": "待梳理",
      "required": [
        "reason"
      ]
    }
  },
  "followup_fields": {
    "id": "string",
    "content": "trimmed text, 1..5000",
    "at": "ISO timestamp",
    "actor": "我"
  }
}