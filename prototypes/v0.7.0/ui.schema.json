          }
        ]
      },
      {
        "id": "logout-clears-cache",
        "requirement_ids": [
          "REQ-004"
        ],
        "steps": [
          {
            "action": "fill",
            "selector": "#username",
            "value": "test"
          },
          {
            "action": "fill",
            "selector": "#password",
            "value": "1234"
          },
          {
            "action": "click",
            "selector": "#account-auth-form button[type='submit']"
          },
          {
            "action": "expect_visible",
            "selector": "#workbench"
          },
          {
            "action": "click",
