{
  "version": "1.0.0",
  "page": {
    "id": "shixu-r6-auth-session",
    "states": [
      "login",
      "workbench_confirming",
      "workbench_ready",
      "shell_painted_confirming",
      "confirm_failed_kept",
      "auth_pending"
    ],
    "views": [
      "login",
      "today",
      "issues",
      "tasks"
    ]
  },
  "components": [
    {
      "id": "auth-form",
      "type": "form",
      "states": [
        "idle",
        "error"
      ],
      "events": [
        "EVT-AUTH-SUBMIT"
      ]
    },
    {
      "id": "auth-mode-toggle",
      "type": "button",
      "states": [
        "login",
        "register"
      ],
      "events": [
        "EVT-AUTH-MODE"
      ]
    },
    {
      "id": "auth-connect-link",
      "type": "link",
      "states": [
        "default",
        "hover",
        "focus"
      ],
      "events": [
        "EVT-AUTH-CONNECT"
      ]
    },
    {
      "id": "connect-dialog",
      "type": "dialog",
      "states": [
        "open",
        "closed"
      ],
      "events": [
        "EVT-CONNECT-CLOSE"
      ]
    },
    {
      "id": "refresh-button",
      "type": "button",
      "states": [
        "idle"
      ],
      "events": [
        "EVT-REFRESH"
      ]
    },
    {
      "id": "logout-button",
      "type": "button",
      "states": [
        "idle"
      ],
      "events": [
        "EVT-LOGOUT"
      ]
    },
    {
      "id": "nav-item",
      "type": "button",
      "states": [
        "active",
        "idle"
      ],
      "events": [
        "EVT-NAV"
      ]
    },
    {
      "id": "account-pill",
      "type": "button",
      "states": [
        "idle"
      ],
      "events": [
        "EVT-ACCOUNT-MENU"
      ]
    },
    {
      "id": "demo-toggle",
      "type": "button",
      "states": [
        "idle"
      ],
      "events": [
        "EVT-DEMO-TOGGLE"
      ]
    },
    {
      "id": "demo-outcome",
      "type": "button",
      "states": [
        "pressed",
        "idle"
      ],
      "events": [
        "EVT-DEMO-OUTCOME"
      ]
    },
    {
      "id": "demo-seed",
      "type": "button",
      "states": [
        "idle"
      ],
      "events": [
        "EVT-DEMO-SEED"
      ]
    },
    {
      "id": "demo-clear",
      "type": "button",
      "states": [
        "idle"
      ],
      "events": [
        "EVT-DEMO-CLEAR"
      ]
    },
    {
      "id": "sync-state",
      "type": "status",
      "states": [
        "confirming",
        "ok",
        "warn"
      ],
      "events": []
    },
    {
      "id": "early-shell",
      "type": "script",
      "states": [
        "painted",
        "skipped"
      ],
      "events": []
    },
    {
      "id": "sync-retry",
      "type": "button",
      "states": [
        "hidden",
        "visible"
      ],
      "events": [
        "EVT-SYNC-RETRY"
      ]
    },
    {
      "id": "demo-switch",
      "type": "button",
      "states": [
        "idle"
      ],
      "events": [
        "EVT-DEMO-SWITCH"
      ]
    },
    {
      "id": "content-skeleton",
      "type": "skeleton",
      "states": [
        "pending",
        "ready"
      ],
      "events": []
    },
    {
      "id": "demo-submit-fail",
      "type": "toggle",
      "states": [
        "off",
        "on"
      ],
      "events": [
        "EVT-DEMO-SUBMITFAIL"
      ],
      "note": "演示用，非生产"
    }
  ],
  "entity_states": {
    "session": [
      "anonymous",
      "shell_painted_confirming",
      "confirmed",
      "confirm_failed_kept",
      "expired",
      "identity_corrected"
    ]
  },
  "notes": [
    "localStorage 键 shixu-local-user 仅含 id、displayName（与 r6/v0.5.0 相同）",
    "#early-shell 内联脚本位于外壳标记后、主脚本前；只画外壳，不请求、不加载数据",
    "#workbench[data-shell-owner] 记录外壳属于哪个 id；bootAccount 同 id 不重画",
    "工作台数据只在 /api/auth/me 确认后按已确认 id 加载",
    "sessionStorage shixu-demo-outcome 仅原型演示用，落地不存在"
  ],
  "responsive": {
    "mode": "adaptive",
    "mobile_breakpoint": 700,
    "layouts": {
      "desktop": "登录双栏故事+表单；工作台左侧导航+顶栏同步徽标；演示控件右下角；r7：外壳（侧栏/顶栏/身份）先画，统计与清单为骨架，确认后填充；r8：提交按钮进行中态「登录中…/创建中…」+转圈，禁用",
      "mobile": "登录单列隐藏故事正文；工作台去侧栏，顶栏账号+底部三入口；演示控件上移避开底栏；r7：顶栏身份+底栏先画，内容骨架；r8：提交按钮进行中态「登录中…/创建中…」+转圈，禁用"
    },
    "viewports": [
      {
        "width": 360,
        "height": 844
      },
      {
        "width": 390,
        "height": 844
      },
      {
        "width": 430,
        "height": 844
      },
      {
        "width": 1440,
        "height": 1000
      }
    ],
    "scenarios": [
      {
        "id": "connect-link-style-and-open",
        "requirement_ids": [
          "REQ-001"
        ],
        "steps": [
          {
            "action": "expect_visible",
            "selector": "a.auth-connect"
          },
          {
            "action": "click",
            "selector": "a.auth-connect[data-event-id='EVT-AUTH-CONNECT']"
          },
          {
            "action": "expect_text",
            "selector": "#connect-title",
            "value": "连接 AI"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-CONNECT-CLOSE']"
          },
          {
            "action": "expect_visible",
            "selector": "#account-auth-form"
          }
        ]
      },
      {
        "id": "login-pending-immediate",
        "requirement_ids": [
          "REQ-009",
          "REQ-010"
        ],
        "steps": [
          {
            "action": "fill",
            "selector": "#username",
            "value": "test"
          },
          {
            "action": "fill",
            "selector": "#password",
            "value": "1234"
          },
          {
            "action": "click",
            "selector": "#account-auth-form button[type='submit']"
          },
          {
            "action": "expect_text",
            "selector": "#account-auth-form button[type='submit']",
            "value": "登录中…"
          },
          {
            "action": "expect_visible",
            "selector": "#account-auth-form[data-pending='true']"
          }
        ]
      },
      {
        "id": "register-pending-immediate",
        "requirement_ids": [
          "REQ-009",
          "REQ-010"
        ],
        "steps": [
          {
            "action": "click",
            "selector": "#auth-mode-btn"
          },
          {
            "action": "fill",
            "selector": "#username",
            "value": "newbie"
          },
          {
            "action": "fill",
            "selector": "#displayName",
            "value": "新同学"
          },
          {
            "action": "fill",
            "selector": "#password",
            "value": "abcd"
          },
          {
            "action": "click",
            "selector": "#account-auth-form button[type='submit']"
          },
          {
            "action": "expect_text",
            "selector": "#account-auth-form button[type='submit']",
            "value": "创建中…"
          },
          {
            "action": "expect_visible",
            "selector": "#account-auth-form[data-pending='true']"
          }
        ]
      },
      {
        "id": "login-failure-restores-label",
        "requirement_ids": [
          "REQ-011"
        ],
        "steps": [
          {
            "action": "fill",
            "selector": "#username",
            "value": "test"
          },
          {
            "action": "fill",
            "selector": "#password",
            "value": "9999"
          },
          {
            "action": "click",
            "selector": "#account-auth-form button[type='submit']"
          },
          {
            "action": "expect_text",
            "selector": "#account-auth-form button[type='submit']",
            "value": "登录中…"
          },
          {
            "action": "expect_text",
            "selector": "#account-auth-error",
            "value": "账号或密码不正确"
          },
          {
            "action": "expect_text",
            "selector": "#account-auth-form button[type='submit']",
            "value": "登录工作台"
          }
        ]
      },
      {
        "id": "login-writes-local-cache",
        "requirement_ids": [
          "REQ-002",
          "REQ-012"
        ],
        "steps": [
          {
            "action": "fill",
            "selector": "#username",
            "value": "test"
          },
          {
            "action": "fill",
            "selector": "#password",
            "value": "1234"
          },
          {
            "action": "click",
            "selector": "#account-auth-form button[type='submit']"
          },
          {
            "action": "expect_text",
            "selector": "#account-auth-form button[type='submit']",
            "value": "登录中…"
          },
          {
            "action": "expect_text",
            "selector": "#desk-name",
            "value": "测试用户"
          },
          {
            "action": "expect_text",
            "selector": "#sync-state",
            "value": "已同步"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-TOGGLE']"
          },
          {
            "action": "expect_text",
            "selector": "#demo-meta",
            "value": "displayName"
          }
        ]
      },
      {
        "id": "refresh-early-shell-then-fill",
        "requirement_ids": [
          "REQ-005",
          "REQ-006"
        ],
        "steps": [
          {
            "action": "expect_visible",
            "selector": "#workbench"
          },
          {
            "action": "expect_text",
            "selector": "#desk-name",
