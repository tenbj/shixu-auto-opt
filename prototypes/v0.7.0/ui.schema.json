            "value": "已同步"
          },
          {
            "action": "expect_text",
            "selector": "#stat-0",
            "value": "03"
          }
        ]
      },
      {
        "id": "non-401-keeps-workbench",
        "requirement_ids": [
          "REQ-008"
        ],
        "steps": [
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-TOGGLE']"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-OUTCOME'][data-outcome='error502']"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-REFRESH']"
          },
          {
            "action": "expect_text",
            "selector": "#sync-state",
            "value": "暂未同步"
          },
          {
            "action": "expect_visible",
            "selector": "[data-event-id='EVT-SYNC-RETRY']"
          },
          {
            "action": "expect_visible",
            "selector": "#workbench"
          }
        ]
      },
      {
        "id": "confirm-fail-401-back-to-login",
        "requirement_ids": [
          "REQ-004",
          "REQ-008"
        ],
        "steps": [
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-TOGGLE']"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-OUTCOME'][data-outcome='fail401']"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-SEED']"
          },
          {
            "action": "expect_text",
            "selector": "#account-auth-error",
            "value": "登录已过期"
