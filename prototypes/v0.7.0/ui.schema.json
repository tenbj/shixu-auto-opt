        ],
        "steps": [
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-TOGGLE']"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-OUTCOME'][data-outcome='success']"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-SWITCH']"
          },
          {
            "action": "expect_text",
            "selector": "#desk-name",
            "value": "林夏"
          },
          {
            "action": "expect_text",
            "selector": "#sync-state",
            "value": "已同步"
          },
          {
            "action": "expect_text",
            "selector": "#stat-0",
            "value": "01"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-TOGGLE']"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-OUTCOME'][data-outcome='mismatch']"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-REFRESH']"
          },
          {
            "action": "expect_text",
            "selector": "#desk-name",
            "value": "测试用户"
          },
          {
            "action": "expect_text",
