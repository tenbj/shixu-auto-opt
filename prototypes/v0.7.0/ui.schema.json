          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-TOGGLE']"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-DEMO-OUTCOME'][data-outcome='pending']"
          },
          {
            "action": "click",
            "selector": "[data-event-id='EVT-REFRESH']"
          },
          {
            "action": "expect_visible",
            "selector": "#workbench"
          },
          {
            "action": "expect_text",
            "selector": "#sync-state",
            "value": "同步中"
          },
          {
            "action": "expect_visible",
